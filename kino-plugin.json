{
  "id": "unlimitedsubs",
  "name": "Toku Kino",
  "version": "0.1.6",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Tokusatsu en Kino. Prueba de Mirai Sentai Timeranger de ShadowRangers, con 50 capítulos y fuentes VOE y ShadowLiv. Requiere Kino 0.9.50 o superior.",
  "hosts": [
    "www.subsunlimiteds.com",
    "ulsapi.unlimiteds.workers.dev",
    "vk.com",
    "*.vk.com",
    "vkvideo.ru",
    "*.vkvideo.ru",
    "shadowrangers.live",
    "voe.sx",
    "teresapoliticallearn.com",
    "shadowliv.xyz"
  ],
  "browser": true,
  "streamHosts": "any",
  "color": "#267DBA",
  "categories": [
    "series"
  ],
  "capabilities": [
    "search",
    "home",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "shadowServer",
      "type": "select",
      "label": "Fuente preferida para Timeranger",
      "default": "voe",
      "options": [
        {
          "value": "voe",
          "label": "Server 2 · VOE"
        },
        {
          "value": "shadowliv",
          "label": "Server 3 · ShadowLiv"
        }
      ]
    }
  ]
}
