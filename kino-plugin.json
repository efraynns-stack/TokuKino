{
  "id": "unlimitedsubs",
  "name": "Toku Kino",
  "version": "0.1.9",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Tokusatsu organizado en Super Sentai y Kamen Rider. Super Sentai de ShadowRangers por serie y año; prueba de Gavv en Kamen Rider. Requiere Kino 0.9.50 o superior.",
  "hosts": [
    "www.subsunlimiteds.com",
    "ulsapi.unlimiteds.workers.dev",
    "vk.com",
    "*.vk.com",
    "vkvideo.ru",
    "*.vkvideo.ru",
    "shadowrangers.live",
    "voe.sx",
    "teresapoliticallearn.com",
    "shadowliv.xyz"
  ],
  "browser": true,
  "streamHosts": "any",
  "color": "#267DBA",
  "categories": [
    "series"
  ],
  "capabilities": [
    "search",
    "home",
    "episodes",
    "resolve",
    "browse"
  ],
  "settings": [
    {
      "key": "catalog",
      "type": "section",
      "label": "Catálogo",
      "hint": "Estado al abrir Ajustes o terminar la carga del catálogo."
    },
    {
      "key": "catalogStatus",
      "type": "status",
      "label": "Super Sentai"
    },
    {
      "key": "catalogUpdated",
      "type": "status",
      "label": "Última carga (UTC)"
    },
    {
      "key": "refreshCatalog",
      "type": "action",
      "label": "Actualizar catálogo Super Sentai"
    },
    {
      "key": "riderStatus",
      "type": "status",
      "label": "Kamen Rider"
    },
    {
      "key": "shadowServer",
      "type": "select",
      "label": "Fuente preferida",
      "default": "voe",
      "options": [
        {
          "value": "voe",
          "label": "Server 2 · VOE"
        },
        {
          "value": "shadowliv",
          "label": "Server 3 · ShadowLiv"
        }
      ]
    }
  ],
  "section": {
    "label": "Toku Kino"
  }
}
